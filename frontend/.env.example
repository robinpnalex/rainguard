# Leave UNSET for both local development and the all-in-one Vercel deploy:
#   - locally, the Vite dev proxy forwards /api to localhost:8000
#   - on Vercel, the API is same-origin at /api
#
# Only set this if you host the API on a different domain, e.g.
# VITE_API_BASE=https://rainguard-api-zzw6.onrender.com
